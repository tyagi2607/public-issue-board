# Application
APP_NAME="Public Issue Board"
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/public_issue_board

# JWT – CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://localhost:6379/0

# S3-compatible file storage (optional)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=public-issue-board
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
